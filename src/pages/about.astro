---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About · ${SITE_TITLE}`} description="About Windstorm Services." />
		<style>
			.page-header {
				text-align: center;
				padding: 4em 1em 2em 1em;
			}
			.about-content {
				max-width: 640px;
				margin: 0 auto;
				padding: 0 1em 4em 1em;
			}
			.about-content p {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>About Windstorm Services</h1>
			</div>
			<div class="about-content">
				<p>
					Windstorm Services is an app development company. We design, build, and maintain custom
					web and mobile software for the businesses we work with.
				</p>
				<p>More details about our team and background coming soon.</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
