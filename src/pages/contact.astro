---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact · ${SITE_TITLE}`} description="Get in touch with Windstorm Services." />
		<style>
			.page-header {
				text-align: center;
				padding: 4em 1em 2em 1em;
			}
			.page-header p {
				color: rgb(var(--gray));
				max-width: 480px;
				margin: 0.5em auto 0 auto;
			}
			form {
				max-width: 520px;
				margin: 0 auto;
				padding: 0 1em 4em 1em;
				display: flex;
				flex-direction: column;
				gap: 1.25em;
			}
			label {
				display: flex;
				flex-direction: column;
				gap: 0.4em;
				font-weight: 700;
				color: rgb(var(--black));
			}
			input,
			textarea {
				font-family: inherit;
				font-size: 1em;
				padding: 0.75em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				color: rgb(var(--gray-dark));
			}
			textarea {
				min-height: 140px;
				resize: vertical;
			}
			input:focus,
			textarea:focus {
				outline: none;
				border-color: var(--accent);
			}
			button.btn {
				align-self: flex-start;
				border: none;
				cursor: pointer;
				font-family: inherit;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Get in touch</h1>
				<p>Tell us a bit about your project and we'll get back to you.</p>
			</div>
			<form>
				<label>
					Name
					<input type="text" name="name" required />
				</label>
				<label>
					Email
					<input type="email" name="email" required />
				</label>
				<label>
					Message
					<textarea name="message" required></textarea>
				</label>
				<button type="submit" class="btn btn-primary">Send message</button>
			</form>
		</main>
		<Footer />
	</body>
</html>
