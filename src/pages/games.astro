---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Games · ${SITE_TITLE}`} description="Games from Windstorm Services." />
		<style>
			.page-header {
				text-align: center;
				padding: 4em 1em 2em 1em;
			}
			.page-header p {
				color: rgb(var(--gray));
				max-width: 480px;
				margin: 0.5em auto 0 auto;
			}
			.empty-state {
				max-width: 480px;
				margin: 0 auto;
				padding: 2em 1em 5em 1em;
				text-align: center;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Games</h1>
				<p>What we're making.</p>
			</div>
			<div class="empty-state">
				<p>Details on our games are coming soon.</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
