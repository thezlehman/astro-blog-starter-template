---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.hero {
				position: relative;
				overflow: hidden;
				padding: 5em 1em 6em 1em;
				text-align: center;
				background:
					radial-gradient(circle at 15% 20%, rgba(35, 55, 255, 0.16), transparent 45%),
					radial-gradient(circle at 85% 0%, rgba(35, 55, 255, 0.12), transparent 40%),
					linear-gradient(180deg, #fff, rgba(var(--gray-light), 45%));
			}
			.hero::before {
				content: '';
				position: absolute;
				inset: 0;
				background-image: radial-gradient(rgba(var(--black), 6%) 1px, transparent 1px);
				background-size: 22px 22px;
				mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, black, transparent);
				pointer-events: none;
			}
			.hero-inner {
				position: relative;
				max-width: 780px;
				margin: 0 auto;
			}
			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				font-size: 0.9rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--accent);
				background: rgba(35, 55, 255, 0.08);
				border: 1px solid rgba(35, 55, 255, 0.18);
				padding: 0.4em 1em;
				border-radius: 999px;
				margin-bottom: 1.5em;
			}
			.hero h1 {
				font-size: clamp(2.5em, 6vw, 3.8em);
				background: linear-gradient(120deg, rgb(var(--black)) 30%, var(--accent));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.hero p.lede {
				font-size: 1.25em;
				color: rgb(var(--gray));
				max-width: 620px;
				margin: 0.5em auto 2em auto;
			}
			.cta-row {
				display: flex;
				justify-content: center;
				gap: 1em;
				flex-wrap: wrap;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.85em 1.6em;
				border-radius: 10px;
				font-weight: 700;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.btn-primary {
				background: linear-gradient(135deg, var(--accent), var(--accent-dark));
				color: #fff;
				box-shadow: 0 8px 20px rgba(35, 55, 255, 0.35);
			}
			.btn-primary:hover {
				color: #fff;
				transform: translateY(-2px);
				box-shadow: 0 12px 28px rgba(35, 55, 255, 0.45);
			}
			.btn-ghost {
				background: #fff;
				color: rgb(var(--black));
				border: 1px solid rgb(var(--gray-light));
			}
			.btn-ghost:hover {
				color: var(--accent);
				border-color: var(--accent);
				transform: translateY(-2px);
			}

			.section {
				padding: 4em 1em;
			}
			.section-inner {
				width: 960px;
				max-width: 100%;
				margin: auto;
			}
			.section-header {
				text-align: center;
				max-width: 560px;
				margin: 0 auto 2.5em auto;
			}
			.section-header h2 {
				font-size: 2em;
			}
			.section-header p {
				color: rgb(var(--gray));
				margin-bottom: 0;
			}

			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5em;
			}
			.feature-card {
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				padding: 2em 1.5em;
				transition: 0.2s ease;
			}
			.feature-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-4px);
				border-color: transparent;
			}
			.feature-icon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 48px;
				height: 48px;
				border-radius: 12px;
				font-size: 1.4em;
				margin-bottom: 1em;
				background: rgba(35, 55, 255, 0.1);
			}
			.feature-card h3 {
				font-size: 1.25em;
				margin-bottom: 0.4em;
			}
			.feature-card p {
				color: rgb(var(--gray));
				margin-bottom: 0;
				font-size: 0.95em;
			}

			.posts-section {
				background: rgba(var(--gray-light), 35%);
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				background: #fff;
				border-radius: 16px;
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				transition: 0.2s ease;
			}
			.post-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-4px);
			}
			.post-card a {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.post-card img {
				display: block;
				width: 100%;
				height: 160px;
				object-fit: cover;
				border-radius: 0;
			}
			.post-card .post-body {
				padding: 1.25em;
			}
			.post-card .date {
				margin: 0 0 0.3em 0;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.post-card h4 {
				margin: 0;
				font-size: 1.15em;
				line-height: 1.3;
			}
			.post-card a:hover h4 {
				color: var(--accent);
			}
			.view-all {
				text-align: center;
				margin-top: 2.5em;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 3.5em 1em 3em 1em;
				}
				.features,
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-inner">
					<span class="eyebrow">🧑‍🚀 Welcome aboard</span>
					<h1>Stories, ideas, and things worth sharing</h1>
					<p class="lede">{SITE_DESCRIPTION}</p>
					<div class="cta-row">
						<a class="btn btn-primary" href="/blog">Read the blog →</a>
						<a class="btn btn-ghost" href="/about">About me</a>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="section-inner">
					<div class="section-header">
						<h2>Why you're here</h2>
						<p>A fast, minimal home for writing that's built to grow with you.</p>
					</div>
					<div class="features">
						<div class="feature-card">
							<div class="feature-icon">⚡</div>
							<h3>Fast by default</h3>
							<p>Built on Astro for near-instant page loads and zero unnecessary JavaScript.</p>
						</div>
						<div class="feature-card">
							<div class="feature-icon">✍️</div>
							<h3>Made for writing</h3>
							<p>Markdown and MDX support out of the box, so you can focus on the words.</p>
						</div>
						<div class="feature-card">
							<div class="feature-icon">🎨</div>
							<h3>Easy to make yours</h3>
							<p>Clean, well-organized components and styles that are simple to customize.</p>
						</div>
					</div>
				</div>
			</section>

			{
				posts.length > 0 && (
					<section class="section posts-section">
						<div class="section-inner">
							<div class="section-header">
								<h2>Latest posts</h2>
								<p>Fresh from the blog.</p>
							</div>
							<ul class="posts-grid">
								{posts.map((post) => (
									<li class="post-card">
										<a href={`/blog/${post.id}/`}>
											<img width={720} height={360} src={post.data.heroImage} alt="" />
											<div class="post-body">
												<p class="date">
													<FormattedDate date={post.data.pubDate} />
												</p>
												<h4>{post.data.title}</h4>
											</div>
										</a>
									</li>
								))}
							</ul>
							<div class="view-all">
								<a class="btn btn-ghost" href="/blog">View all posts →</a>
							</div>
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
