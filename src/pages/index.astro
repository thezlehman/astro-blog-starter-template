---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.hero {
				position: relative;
				overflow: hidden;
				padding: 5em 1em 6em 1em;
				text-align: center;
				background:
					radial-gradient(circle at 15% 20%, rgba(35, 55, 255, 0.16), transparent 45%),
					radial-gradient(circle at 85% 0%, rgba(35, 55, 255, 0.12), transparent 40%),
					linear-gradient(180deg, #fff, rgba(var(--gray-light), 45%));
			}
			.hero::before {
				content: '';
				position: absolute;
				inset: 0;
				background-image: radial-gradient(rgba(var(--black), 6%) 1px, transparent 1px);
				background-size: 22px 22px;
				mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, black, transparent);
				pointer-events: none;
			}
			.hero-inner {
				position: relative;
				max-width: 780px;
				margin: 0 auto;
			}
			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				font-size: 0.9rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--accent);
				background: rgba(35, 55, 255, 0.08);
				border: 1px solid rgba(35, 55, 255, 0.18);
				padding: 0.4em 1em;
				border-radius: 999px;
				margin-bottom: 1.5em;
			}
			.hero h1 {
				font-size: clamp(2.5em, 6vw, 3.8em);
				background: linear-gradient(120deg, rgb(var(--black)) 30%, var(--accent));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.hero p.lede {
				font-size: 1.25em;
				color: rgb(var(--gray));
				max-width: 620px;
				margin: 0.5em auto 2em auto;
			}
			.cta-row {
				display: flex;
				justify-content: center;
				gap: 1em;
				flex-wrap: wrap;
			}
			.section {
				padding: 4em 1em;
			}
			.section-inner {
				width: 960px;
				max-width: 100%;
				margin: auto;
			}
			.section-header {
				text-align: center;
				max-width: 560px;
				margin: 0 auto 2.5em auto;
			}
			.section-header h2 {
				font-size: 2em;
			}
			.section-header p {
				color: rgb(var(--gray));
				margin-bottom: 0;
			}

			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5em;
			}
			.feature-card {
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				padding: 2em 1.5em;
				transition: 0.2s ease;
			}
			.feature-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-4px);
				border-color: transparent;
			}
			.feature-icon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 48px;
				height: 48px;
				border-radius: 12px;
				font-size: 1.4em;
				margin-bottom: 1em;
				background: rgba(35, 55, 255, 0.1);
			}
			.feature-card h3 {
				font-size: 1.25em;
				margin-bottom: 0.4em;
			}
			.feature-card p {
				color: rgb(var(--gray));
				margin-bottom: 0;
				font-size: 0.95em;
			}

			.cta-band {
				background: rgba(var(--gray-light), 35%);
				text-align: center;
			}
			.cta-band h2 {
				margin-bottom: 0.3em;
			}
			.cta-band p {
				color: rgb(var(--gray));
				max-width: 480px;
				margin: 0 auto 1.5em auto;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 3.5em 1em 3em 1em;
				}
				.features {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-inner">
					<span class="eyebrow">⚡ Windstorm Services</span>
					<h1>We build the software your business runs on</h1>
					<p class="lede">{SITE_DESCRIPTION} From idea to launch to long-term support.</p>
					<div class="cta-row">
						<a class="btn btn-primary" href="/contact">Start a project →</a>
						<a class="btn btn-ghost" href="/services">See our services</a>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="section-inner">
					<div class="section-header">
						<h2>What we do</h2>
						<p>An in-house team that plans, builds, and maintains your software.</p>
					</div>
					<div class="features">
						<div class="feature-card">
							<div class="feature-icon">🖥️</div>
							<h3>Web applications</h3>
							<p>Custom web apps and internal tools, designed and built around how you actually work.</p>
						</div>
						<div class="feature-card">
							<div class="feature-icon">📱</div>
							<h3>Mobile apps</h3>
							<p>Native and cross-platform apps for iOS and Android, from prototype to app store.</p>
						</div>
						<div class="feature-card">
							<div class="feature-icon">🛠️</div>
							<h3>Ongoing support</h3>
							<p>We don't disappear after launch — updates, fixes, and improvements as you grow.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="section cta-band">
				<div class="section-inner">
					<h2>Already working with a team?</h2>
					<p>Good — we're all set here. If you're a vendor reaching out, we're not looking for new partners right now.</p>
					<a class="btn btn-ghost" href="/contact">Reach out anyway</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
