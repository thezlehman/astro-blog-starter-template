---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const services = [
	{
		icon: '🖥️',
		title: 'Web application development',
		description:
			'Custom web apps and internal tools built to match how your business actually operates, not the other way around.',
	},
	{
		icon: '📱',
		title: 'Mobile app development',
		description:
			'Native and cross-platform mobile apps for iOS and Android, from first prototype through app store launch.',
	},
	{
		icon: '🔗',
		title: 'Integrations & APIs',
		description:
			'Connecting the tools you already use, or building APIs so other systems can talk to yours.',
	},
	{
		icon: '🛠️',
		title: 'Ongoing support & maintenance',
		description:
			'Bug fixes, updates, and new features after launch, from a team that already knows your codebase.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Services · ${SITE_TITLE}`} description="What we build at Windstorm Services." />
		<style>
			.page-header {
				text-align: center;
				padding: 4em 1em 2em 1em;
			}
			.page-header p {
				color: rgb(var(--gray));
				max-width: 560px;
				margin: 0.5em auto 0 auto;
			}
			.services-list {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.service-card {
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				padding: 2em;
				transition: 0.2s ease;
			}
			.service-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-4px);
				border-color: transparent;
			}
			.service-icon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 48px;
				height: 48px;
				border-radius: 12px;
				font-size: 1.4em;
				margin-bottom: 1em;
				background: rgba(35, 55, 255, 0.1);
			}
			.service-card h3 {
				font-size: 1.3em;
				margin-bottom: 0.4em;
			}
			.service-card p {
				color: rgb(var(--gray));
				margin-bottom: 0;
			}
			.cta-band {
				text-align: center;
				margin-top: 3em;
			}
			@media (max-width: 720px) {
				.services-list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Services</h1>
				<p>What we build, and how we keep it running after launch.</p>
			</div>
			<ul class="services-list">
				{
					services.map((service) => (
						<li class="service-card">
							<div class="service-icon">{service.icon}</div>
							<h3>{service.title}</h3>
							<p>{service.description}</p>
						</li>
					))
				}
			</ul>
			<div class="cta-band">
				<a class="btn btn-primary" href="/contact">Tell us about your project →</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
